# 密钥与环境
.env
llm_settings.json

# 运行时产物
uploads/
__pycache__/
*.pyc

# 工作流当前选择（运行时可变）
modules/training/workflow/current.json

# 数据库档位选择（运行时可变）
db_profile.json
.vendor/

# 本地数据备份（非源码，可能含生产数据，勿上传）
db/database/*.sql
db/*.sql
db/export/
*.bak.sql
*.bak
data/*_bak_*.sql

# 历史归档（清理移入的无用/测试文件，勿上传）
history/

# 外部工具记忆目录（自动再生）
.workbuddy/

# 前端工程（Vue 3 + Vite）：依赖与构建产物不入库
frontend/node_modules/
frontend/dist/
