# ============================================================
# deshu5 环境变量示例（脱敏模板）
#
# 用法：
#   1. 复制本文件为 .env  ->  cp .env.example .env
#   2. 把下方占位符替换为真实值
#   3. .env 已在 .gitignore 中，永远不会被提交/上传
# ============================================================

# ===================== LLM（Kimi / 兼容 OpenAI 协议）=====================
KIMI_API_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=kimi-for-coding-highspeed
KIMI_TEMPERATURE=0.6

# ===================== 数据库底座 =====================
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# 三库分工（生产）
MYSQL_DB_BUSINESS=marketing_40
MYSQL_DB_GOVERNANCE=marketing_governance
MYSQL_DB_LOG=marketing_log

# 本体库（新增模块）
MYSQL_DB_ONTOLOGY=marketing_ontology

# ===================== 应用 =====================
FLASK_PORT=5000
FLASK_DEBUG=false
